{
  "name": "altura",
  "version": "0.1.0",
  "private": true,
  "description": "Altura monorepo - personal trip planning system for hikers and intentional travelers.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,prisma,yml,yaml}\"",
    "db:dev": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "api:dev": "pnpm --filter @altura/api dev",
    "web:dev": "pnpm --filter @altura/web dev",
    "api:prisma:generate": "pnpm --filter @altura/api prisma:generate",
    "api:prisma:migrate": "pnpm --filter @altura/api prisma:migrate",
    "api:prisma:seed": "pnpm --filter @altura/api prisma:seed"
  },
  "devDependencies": {
    "@altura/tsconfig": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
